# The service listens only on the dedicated wired control network.
ISV2_BIND_HOST=192.168.2.5
ISV2_BIND_PORT=8000

# "auto" prefers /dev/serial/by-id/* and then /dev/ttyUSB*.
# Replace it with a /dev/serial/by-id/... path after identifying the adapter.
ISV2_SERIAL_PORT=auto
ISV2_BAUD=38400
ISV2_SERIAL_TIMEOUT=0.4
ISV2_PARITY=N
ISV2_STOPBITS=2

ISV2_LEFT_ID=2
ISV2_RIGHT_ID=1
ISV2_LEFT_INVERTED=false
ISV2_RIGHT_INVERTED=false
ISV2_MAX_RPM=1500
ISV2_DEFAULT_ACCEL=10000
ISV2_DEFAULT_DECEL=10000

ISV2_JOG_REFRESH_INTERVAL=0.08
ISV2_HEARTBEAT_INTERVAL=0.25
ISV2_WATCHDOG_TIMEOUT=1.0
ISV2_SERIAL_RETRY_INTERVAL=2.0
